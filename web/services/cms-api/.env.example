PORT=4000
DATABASE_URL="mysql://root:root@localhost:3306/ganzi_cms?charset=utf8mb4"
CMS_API_PUBLIC_ONLY="false"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

STORAGE_PROVIDER="minio"
STORAGE_PUBLIC_BASE_URL="http://localhost:9000/ganzi"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="ganzi"

# Directus CMS API base URL for public content reads.
# Can also be supplied via DIRECTUS_URL.
CMS_BASE_URL="http://localhost:8055"

# Optional server-side credentials when Directus Public policies are restricted.
# The API still only returns published/enabled content after applying its own filters.
DIRECTUS_EMAIL=""
DIRECTUS_PASSWORD=""
